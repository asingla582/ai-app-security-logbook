# Copy to .env and fill in. For local dev these match the Supabase CLI defaults,
# printed by `npx supabase status`. For the hosted project, copy them from the
# Supabase dashboard (Project Settings -> API and Database).

# Supabase project URL (local default shown)
SUPABASE_URL=http://127.0.0.1:54321

# JWT secret used to verify access tokens (local default shown)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Direct Postgres connection (local default shown)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Anon key for the browser client (from `npx supabase status`)
SUPABASE_ANON_KEY=

# Service role key — server/seed only, NEVER exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Web app: where the browser reaches the API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Week 2: model gateway. Needed only to chat against the real model; the test
# suite and CI run a deterministic fake and need no key. Get one from the
# Anthropic Console. Optional overrides: CHAT_MODEL (default claude-opus-4-8),
# MAX_OUTPUT_TOKENS, MAX_INPUT_CHARS, HISTORY_WINDOW.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-4-8

# Week 5: embeddings for document retrieval (RAG). Document text is sent to OpenAI
# at ingest time. Needed only to upload/retrieve against real embeddings; the test
# suite and CI use a deterministic offline fake and need no key. Optional overrides:
# EMBEDDING_MODEL (default text-embedding-3-small), CHUNK_SIZE, RETRIEVAL_TOP_K.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
